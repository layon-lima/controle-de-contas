# O MESMO aplicativo web portátil já usado no Windows; nenhum frontend novo.
FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    QT_QPA_PLATFORM=offscreen CONTAS_PORTABLE_NO_BROWSER=1 \
    CONTAS_APP_DIR=/data/ControleContas CONTAS_PORTABLE_HOST=0.0.0.0 \
    CONTAS_PORTABLE_PORT=8767
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    tesseract-ocr tesseract-ocr-por tesseract-ocr-eng \
    libglib2.0-0 libgl1 libegl1 libxkbcommon0 libdbus-1-3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY deploy/vps/requirements.portable-web.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY portable_app/ /app/portable_app/
COPY cloud_mobile/public/ /app/cloud_mobile/public/
COPY source_current/ /app/source_current/
COPY releases/ /app/releases/
# Falhas em importacao mobile, SQL e filtros impedem a atualizacao da imagem.
RUN python -m py_compile portable_app/server.py portable_app/mobile_vps.py portable_app/r2_bridge.py \
    && python -m unittest -v portable_app.test_mobile_vps portable_app.test_duplicate_checks
CMD ["python", "-u", "portable_app/server.py"]
